# Copy to .env and fill in. Never commit .env.

# Mistral AI (server-side only)
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-2512

# Optional overrides (defaults shown). Leave MAZHAI_DB_PATH unset for local runs;
# the Dockerfile already sets it for containers.
# MAZHAI_DB_PATH=./data/mazhai.db
# UPSTREAM_TIMEOUT_SECONDS=12
# WEATHER_CACHE_TTL_SECONDS=900
# CORS_ORIGINS=http://127.0.0.1:8001,http://localhost:8001
# AI_RATE_LIMIT_PER_MIN=10
# COMPARISON_WORKERS=6
# LOG_LEVEL=INFO
# UPSTREAM_RETRIES=1
# UPSTREAM_RETRY_BACKOFF_SECONDS=0.5
# HISTORY_PAST_CACHE_TTL_SECONDS=86400
# CACHE_RETENTION_DAYS=30
# Behind a proxy (Render, nginx, ...): trust its X-Forwarded-For so rate limiting sees real client IPs.
# FORWARDED_ALLOW_IPS=127.0.0.1
